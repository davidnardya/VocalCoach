platform :ios, '15.0'

target 'iosApp' do
  use_frameworks! :linkage => :static
  pod 'TensorFlowLiteTaskAudio', '0.4.3'
  pod 'composeApp', :path => '../composeApp'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # Xcode links Pods_iosApp.framework explicitly; without this path the linker reports
  # "Framework 'Pods_iosApp' not found" (umbrella output lives under PODS_CONFIGURATION_BUILD_DIR).
  support = File.join(installer.sandbox.root, 'Target Support Files', 'Pods-iosApp')
  Dir.glob(File.join(support, 'Pods-iosApp.*.xcconfig')).each do |path|
    text = File.read(path)
    unless text.include?('"${PODS_CONFIGURATION_BUILD_DIR}"')
      text = text.sub(
        /^(FRAMEWORK_SEARCH_PATHS = .+)$/,
        '\\1 "${PODS_CONFIGURATION_BUILD_DIR}"'
      )
    end
    # TensorFlowLiteTaskAudio 0.4.3 has no arm64 slice for Apple Silicon simulator (device arm64 only).
    # Link it for device only; simulator uses a stub classifier in Kotlin (see composeApp iosSimulatorArm64Main).
    unless text.include?('OTHER_LDFLAGS[sdk=iphoneos*]')
      text = text.sub(
        /^OTHER_LDFLAGS = (.+) -framework "TensorFlowLiteTaskAudio"\s*$/m,
        "OTHER_LDFLAGS[sdk=iphoneos*] = \\1 -framework \"TensorFlowLiteTaskAudio\"\n" \
          "OTHER_LDFLAGS[sdk=iphonesimulator*] = \\1\n"
      )
    end
    File.write(path, text)
  end
end
